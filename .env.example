# Agentverse & ASI:One Configuration
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENT_SEED="mailgent-student-inbox-assistant-secret-seed"
AGENT_MAILBOX_KEY=your_agentverse_mailbox_key_here
# Optional: Set your ASI:One address to restrict inbox operations only to you
OWNER_ADDRESS=

# ASI:One / LLM Classification API
ASI1_API_KEY=your_asi1_or_openai_api_key_here
ASI1_API_BASE=https://api.asi1.ai/v1

# Gmail API Configuration
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Offline Testing / Fallback Mode (set to true to use sample_emails.json instead of live Gmail)
USE_SAMPLE_EMAILS=false
